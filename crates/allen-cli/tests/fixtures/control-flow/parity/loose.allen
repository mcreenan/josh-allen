fn classify(value: Int) returns Int {
  if (value == 0) {
    return 10;
  } else /* comments remain whitespace */ if (value == 1) {
    20
  } else {
    if (true) { 30 } else { 40 }
  }
}

export fn main() returns Int {
  mut total = 0;
  if (true) {
    total = classify(0);
  }
  if (false) {
    total = 999;
  }
  if (false) {
    total = 998;
  } else {
    total = total;
  }
  let extra = if (false) {
    stop("skipped")
  } else if (true) {
    classify(1)
  } else {
    999
  };
  total + extra
}
