fn classify(value: Int) returns Int {
  fn local_score(input: Int) returns Int { input + 1 }
  match value {
    0..=2 | 5..8 => local_score(value)
    _ => 0
  }
}

export fn main() returns Int {
  let span: Range<Int> = 1..=3;
  let values = [0, 1, 2, 3, 4];
  let middle: Option<List<Int>> = values[1..4];
  let mapped: Sequence<Int> = seq.map(
    seq.from_list(middle ?? []),
    fn(value: Int) returns Int { value + 1 }
  );
  let materialized = seq.to_list(seq.take(mapped, 2));
  classify(length(materialized)) + if (span == (1..=3)) { 1 } else { 0 }
}
