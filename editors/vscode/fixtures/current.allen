import { normalize as local_normalize } from "./support.allen";

record Point {
  x: Int
  y: Int
} where { x >= 0 && y >= 0 }

enum Reading {
  Empty
  Number(Int)
  Named { value: Int, label: String }
}

export type Measurements = List<Int>
export newtype EpochSeconds = Int
export const SharedAnswer: Int = 40 + 2;

test "shared answer" {
  let value = SharedAnswer;
  ()
}

export fn main() returns Int {
  let shared = SharedAnswer;
  let epoch = EpochSeconds(42);
  let epoch_value = epoch.value + shared;
  let point = Point { x: 1, y: 2 };
  let separated = 485_273;
  let precise = 12_345.67_89e+1_0;
  let bytes = b"\x00A\n";
  let ratio: Float = -1.5e2 / 2.0;
  mut retries: Int = 0;
  retries = retries + bytes[0];
  for byte in bytes {
    retries = retries + byte;
  }
  for index in 0..2 {
    if (index == 0) { continue; }
    retries = retries + index;
  }
  let weights: Map<String, Int> = map { "later": 2, "first": 1 };
  for (_, weight) in weights {
    retries = retries + weight;
  }
  while (retries < 1000) {
    retries = retries + 1;
    if (retries == 100) { break; }
  }
  loop { break; }
  let reading: Reading = Reading.Named { value: 40, label: "ready" };
  if (point.x == 1) {
    retries = retries + 1;
  }
  match reading {
    Reading.Named { value, label: _ } => value + point.x
    Reading.Empty => 0
    Reading.Number(value) => value
  }
}
