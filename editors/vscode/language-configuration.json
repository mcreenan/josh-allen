{
  "comments": {
    "lineComment": "//",
    "blockComment": [
      "/*",
      "*/"
    ]
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "[",
      "close": "]",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "(",
      "close": ")",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    },
    {
      "open": "`",
      "close": "`",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\""
    },
    {
      "open": "`",
      "close": "`"
    }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.*(?:\\{|\\belse\\s*)\\s*$",
    "decreaseIndentPattern": "^\\s*(?:}|else\\b).*$"
  }
}
