fn classify(value: Int) returns Int {
  fn bump(input: Int) returns Int { input + 1 }

  match value {
    0..=2 | 4..6 => bump(value)
    _ => 0
  }
}

export fn main() returns Int {
  let values = [0, 1, 2, 3, 4, 5];
  let list_slice: List<Int> = values[1..4] ?? [];
  let byte_slice: Bytes = b"abcd"[1..3] ?? b"";
  let text_slice: String = "Allen"[1..4] ?? "";

  let transformed: Sequence<Int> = seq.take(
    seq.filter(
      seq.map(
        seq.from_list(values),
        fn(value: Int) returns Int { value + 1 }
      ),
      fn(value: Int) returns Bool { value % 2 == 0 }
    ),
    2
  );
  let materialized = seq.to_list(transformed);

  let found = seq.find(
    seq.from_list(values),
    fn(value: Int) returns Bool { value == 3 }
  ) ?? 0;
  let has_large = seq.any(
    seq.from_list(values),
    fn(value: Int) returns Bool { value > 4 }
  );
  let all_nonnegative = seq.all(
    seq.from_list(values),
    fn(value: Int) returns Bool { value >= 0 }
  );
  let folded = seq.fold(
    seq.from_list(values),
    0,
    fn(total: Int, value: Int) returns Int { total + value }
  );

  mut range_total = 0;
  let inclusive: Range<Int> = 1..=3;
  for value in inclusive {
    range_total += value;
  }

  length(list_slice)
    + length(byte_slice)
    + length(text_slice)
    + length(materialized)
    + found
    + if (has_large) { 1 } else { 0 }
    + if (all_nonnegative) { 1 } else { 0 }
    + folded
    + range_total
    + classify(4)
    + if ((1..3) == (1..3)) { 1 } else { 0 }
}
