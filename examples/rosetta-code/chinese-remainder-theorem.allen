record ExtendedGcd {
  gcd: Int
  x: Int
  y: Int
}

fn extended_gcd(left: Int, right: Int) returns ExtendedGcd {
  mut old_remainder = left;
  mut remainder = right;
  mut old_x: Int = 1;
  mut x: Int = 0;
  mut old_y: Int = 0;
  mut y: Int = 1;
  while (remainder != 0) {
    let quotient = old_remainder / remainder;
    let next_remainder = old_remainder % remainder;
    let next_x = old_x - quotient * x;
    let next_y = old_y - quotient * y;
    old_remainder = remainder;
    remainder = next_remainder;
    old_x = x;
    x = next_x;
    old_y = y;
    y = next_y;
  }
  ExtendedGcd { gcd: old_remainder, x: old_x, y: old_y }
}

fn normalize_remainder(value: Int, modulus: Int) returns Int {
  mut remainder = value % modulus;
  if (remainder < 0) {
    remainder += modulus;
  }
  remainder
}

fn modular_inverse(value: Int, modulus: Int) returns Int {
  let result = extended_gcd(value, modulus);
  normalize_remainder(result.x, modulus)
}

fn chinese_remainder(congruences: List<(Int, Int)>) returns Int {
  mut modulus_product: Int = 1;
  for (_, modulus) in congruences {
    modulus_product *= modulus;
  }
  mut total: Int = 0;
  for (remainder, modulus) in congruences {
    let partial = modulus_product / modulus;
    total += remainder * partial * modular_inverse(partial, modulus);
  }
  normalize_remainder(total, modulus_product)
}

export fn main() returns (Int, Int) {
  (
    chinese_remainder([(2, 3), (3, 5), (2, 7)]),
    chinese_remainder([(0, 3), (3, 4), (4, 5)]),
  )
}
