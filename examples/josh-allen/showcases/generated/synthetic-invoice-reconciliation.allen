manifest {
  language: "0.1"
  entry: main
  capabilities: [agent.ask]
}

record Invoice {
  invoice_id: String
  vendor_description: String
  vendor_id: String
  amount_cents: Int
  needs_vendor_judgment: Bool
}

record VendorDecision {
  invoice_id: String
  vendor_id: String
  disposition: String
  rationale: String
}

record ReconciliationReport {
  fixture: String
  reconciled_invoice_ids: List<String>
  reconciled_total_cents: Int
  ledger_total_cents: Int
  invoice_total_cents: Int
  exception_invoice_ids: List<String>
  exception_count: Int
  net_discrepancy_cents: Int
  judgment_note: String
}

export async fn main() returns ReconciliationReport effects [agent.ask] {
  // Entirely synthetic, non-sensitive fixture. All monetary values are integer cents.
  let invoices = [
    Invoice { invoice_id: "SYN-INV-1001", vendor_description: "Acme Cloud Services", vendor_id: "ACME-CLOUD", amount_cents: 12500, needs_vendor_judgment: false },
    Invoice { invoice_id: "SYN-INV-1002", vendor_description: "Beta Stationery", vendor_id: "BETA-STATIONERY", amount_cents: 9999, needs_vendor_judgment: false },
    Invoice { invoice_id: "SYN-INV-1003", vendor_description: "Northstar Office Supply - August", vendor_id: "", amount_cents: 2450, needs_vendor_judgment: true },
    Invoice { invoice_id: "SYN-INV-1004", vendor_description: "Delta Paper", vendor_id: "DELTA-PAPER", amount_cents: 3875, needs_vendor_judgment: false }
  ];
  let ledger_vendor_ids = ["ACME-CLOUD", "BETA-STATIONERY", "NORTHSTAR-SUPPLIES", "DELTA-PAPER"];
  let ledger_amounts_cents = [12500, 9999, 2450, 3900];

  // This is the only judgment: the description supports supplies, not NORTHSTAR-OPS.
  let vendor_decision = match await agent.ask<VendorDecision>(prompt {
    system: "Classify only SYN-INV-1003. Choose reconcile only if its description identifies NORTHSTAR-SUPPLIES; otherwise choose exception. Preserve the exact invoice_id and select a candidate vendor_id. Do not alter amounts or other records."
    data: {
      invoice: invoices[2],
      candidate_vendor_ids: ["NORTHSTAR-SUPPLIES", "NORTHSTAR-OPS"],
      allowed_dispositions: ["reconcile", "exception"]
    }
    output: VendorDecision
  }) {
    Ok(value) => value
    Err(_) => VendorDecision { invoice_id: "SYN-INV-1003", vendor_id: "", disposition: "exception", rationale: "judgment unavailable" }
  };

  mut reconciled_invoice_ids: List<String> = [];
  mut exception_invoice_ids: List<String> = [];
  mut reconciled_total_cents = 0;
  mut invoice_total_cents = 0;
  mut ledger_total_cents = 0;

  for invoice in invoices {
    let ledger_index = if (invoice.invoice_id == "SYN-INV-1001") { 0 } else if (invoice.invoice_id == "SYN-INV-1002") { 1 } else if (invoice.invoice_id == "SYN-INV-1003") { 2 } else { 3 };
    let ledger_vendor = ledger_vendor_ids[ledger_index];
    let ledger_amount = ledger_amounts_cents[ledger_index];
    invoice_total_cents = invoice_total_cents + invoice.amount_cents;
    ledger_total_cents = ledger_total_cents + ledger_amount;
    let deterministic_vendor_match = invoice.vendor_id == ledger_vendor;
    let judged_vendor_match = invoice.needs_vendor_judgment && vendor_decision.invoice_id == invoice.invoice_id
      && vendor_decision.vendor_id == ledger_vendor && vendor_decision.disposition == "reconcile";
    let exact_match = invoice.amount_cents == ledger_amount && (deterministic_vendor_match || judged_vendor_match);
    if (exact_match) {
      reconciled_invoice_ids = list.append(reconciled_invoice_ids, invoice.invoice_id);
      reconciled_total_cents = reconciled_total_cents + invoice.amount_cents;
    } else {
      exception_invoice_ids = list.append(exception_invoice_ids, invoice.invoice_id);
    }
  }

  ReconciliationReport {
    fixture: "synthetic invoice-like records; no accounting-system access",
    reconciled_invoice_ids,
    reconciled_total_cents,
    ledger_total_cents,
    invoice_total_cents,
    exception_invoice_ids,
    exception_count: length(exception_invoice_ids),
    net_discrepancy_cents: invoice_total_cents - ledger_total_cents,
    judgment_note: vendor_decision.rationale
  }
}
