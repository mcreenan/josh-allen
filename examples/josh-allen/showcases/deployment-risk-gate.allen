manifest {
  language: "0.1"
  entry: main
  capabilities: [sub_agent.run, user.ask]
}

record Projection {
  capabilities: List<String>
  limits: Map<String, Int>
  tools: List<String>
}

record ReleaseEvidence {
  failing_tests: Int
  in_change_window: Bool
  rollback_verified: Bool
}

record Review {
  approve: Bool
  risk_score: Int
  summary: String
}

record GateResult {
  decision: String
  policy_passed: Bool
  reviewer_risk: Int
  user_approved: Bool
}

export async fn main() returns GateResult effects [sub_agent.run, user.ask] {
  let evidence = ReleaseEvidence {
    failing_tests: 0,
    in_change_window: true,
    rollback_verified: true
  };
  let policy_passed = evidence.failing_tests == 0
    && evidence.in_change_window && evidence.rollback_verified;
  let projection = Projection { capabilities: [], limits: map {}, tools: [] };

  let review = match await sub_agent.run<Review>(prompt {
    system: "Independently review this release evidence. Approve only if every gate passes. Risk score is 0 through 100."
    data: { evidence }
    output: Review
  }, projection) {
    Ok(value) => value
    Err(_) => Review { approve: false, risk_score: 100, summary: "reviewer unavailable" }
  };
  let review_valid = review.risk_score >= 0 && review.risk_score <= 100;
  if (policy_passed && review_valid && review.approve && review.risk_score <= 30) {
    let approved = match await user.ask<Bool>(prompt {
      system: "The deterministic gate and independent review passed. Approve this deployment? Return true or false."
      data: { evidence, review }
      output: Bool
    }) {
      Ok(value) => value
      Err(_) => false
    };
    GateResult {
      decision: if (approved) { "deploy" } else { "hold by user" },
      policy_passed,
      reviewer_risk: review.risk_score,
      user_approved: approved
    }
  } else {
    GateResult { decision: "hold by policy", policy_passed, reviewer_risk: review.risk_score, user_approved: false }
  }
}
